# --- FastAPI backend ---
# Server bind (uvicorn is usually given --host/--port directly; these feed CONFIG)
PORT=8000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:8501

# SMTP envelope identity used by the probe (checks/smtp.py)
HELO_DOMAIN=mail-checker.local
SMTP_FROM=verify@mail-checker.local

# Where /export writes temp files before streaming them back
EXPORT_TMP_DIR=/tmp

# Optional feature flags (default off)
RESULT_CACHE_ENABLED=false
ALLOW_REPUTATION_PROMOTION=false

# --- Streamlit frontend ---
# URL the Streamlit UI uses to reach the FastAPI backend.
# Local default is http://localhost:8000; in Streamlit Cloud point this at the
# public FastAPI host (e.g. your Hetzner box) so port 25 is available there.
BACKEND_URL=http://localhost:8000
